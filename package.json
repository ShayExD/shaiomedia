{
  "name": "shaiomedia",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=shaiomedia-service",
    "deploy:preview": "./deploy-preview.sh",
    "cf:dev": "npm run build && wrangler pages dev dist --compatibility-date=2026-09-01"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/rubik": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "motion": "^13.1.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
