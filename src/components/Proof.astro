---
/**
 * A redacted account export beside the figures it contains.
 *
 * The exports are wide strips: at phone width the full frame leaves each table
 * row about twenty pixels tall, which is not readable. Rather than make the
 * reader drag the image sideways, phones get a narrower crop of the same file
 * that fits whole. Both crops are contiguous regions of the original, so
 * nothing is stitched or rearranged.
 */
import { asset } from "../lib/asset";

interface Props {
  proof: {
    kicker: string;
    title: string;
    lede: string;
    image: string;
    w: number;
    h: number;
    nw: number;
    nh: number;
    alt: string;
    stats: { v: string; l: string }[];
    note: string;
  };
}
const { proof } = Astro.props;
---

<section class="border-t border-ink-100 bg-white py-20 lg:py-28" aria-labelledby="proof-title">
  <div class="mx-auto max-w-5xl px-5">
    <p class="text-sm font-semibold tracking-wide text-brand-500" data-reveal>{proof.kicker}</p>
    <h2 id="proof-title" class="mt-3 text-3xl font-bold text-ink-900 sm:text-4xl" data-reveal>
      {proof.title}
    </h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-600" data-reveal>{proof.lede}</p>

    <dl class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3" data-reveal>
      {proof.stats.map((s) => (
        <div class="rounded-2xl border border-ink-100 bg-paper p-6">
          <dt class="text-sm text-ink-500">{s.l}</dt>
          <dd class="mt-1 text-3xl font-bold tabular-nums text-ink-900">{s.v}</dd>
        </div>
      ))}
    </dl>

    <figure class="mt-8" data-reveal>
      <div class="overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-sm">
        <picture>
          <source
            media="(max-width: 639px)"
            srcset={asset(`images/proof/${proof.image}-narrow.webp`)}
            width={proof.nw}
            height={proof.nh}
          />
          <img
            src={asset(`images/proof/${proof.image}.webp`)}
            alt={proof.alt}
            width={proof.w}
            height={proof.h}
            loading="lazy"
            decoding="async"
            class="block h-auto w-full"
          />
        </picture>
      </div>
      <figcaption class="mt-4 text-sm leading-relaxed text-ink-500">{proof.note}</figcaption>
    </figure>
  </div>
</section>
