---
import { site } from "../data/site";
import Logo from "./Logo.astro";

/**
 * Header and footer for the paid-media pages.
 *
 * These sell to service businesses in Israel; the homepage sells websites and
 * organic work for service businesses in the US. They are deliberately not
 * linked to each other — a visitor who came for campaign management should
 * never land in a pitch aimed at a different market, and the reverse.
 *
 * So: no section links, no route back to the homepage, one action only.
 */
interface Props { part: "header" | "footer" }
const { part } = Astro.props;
const year = new Date().getFullYear();
---

{part === "header" && (
  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.07] bg-ink-950/72 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-5 sm:h-[4.5rem] lg:px-8">
      <span class="shrink-0"><Logo white class="h-7 sm:h-8" /></span>
      <div class="flex items-center gap-2">
        <a href={site.whatsapp} target="_blank" rel="noopener"
           class="hidden items-center gap-2 rounded-full px-3 py-2 text-[0.9375rem] font-bold text-white/85 transition-colors hover:bg-white/10 hover:text-white sm:inline-flex">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.06c-.24.68-1.42 1.32-1.96 1.36-.5.05-.98.22-3.3-.7-2.77-1.1-4.53-3.94-4.67-4.13-.13-.19-1.11-1.48-1.11-2.83s.7-2 .95-2.28c.25-.27.55-.34.73-.34l.52.01c.17.01.4-.06.62.48.24.57.8 1.97.87 2.11.07.14.12.31.02.5-.09.19-.14.31-.28.47l-.42.49c-.14.14-.28.29-.12.57.16.27.72 1.19 1.55 1.93 1.07.95 1.97 1.25 2.25 1.39.27.14.43.12.59-.07.16-.19.68-.79.86-1.07.18-.27.36-.22.61-.13.25.09 1.6.75 1.87.89.27.14.46.2.53.32.07.11.07.65-.17 1.33Z"/></svg>
          וואטסאפ
        </a>
        <a href="#contact" class="btn btn-accent px-5 py-2.5 text-[0.9375rem]">לשיחת ייעוץ</a>
      </div>
    </div>
  </header>
)}

{part === "footer" && (
  <>
    <footer class="border-t border-ink-100 px-5 py-14 lg:px-8">
      <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 text-center">
        <Logo class="h-8" />
        <p class="max-w-md text-[0.9375rem] leading-relaxed text-ink-600">
          ניהול קמפיינים ממומנים לעסקי שירות בישראל. מענה אישי ממי שמנהל את החשבון.
        </p>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-ghost px-4 py-2 text-sm">וואטסאפ</a>
          <a href={`mailto:${site.email}`} class="iso btn btn-ghost px-4 py-2 text-sm">{site.email}</a>
        </div>
        <div class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-ink-500">
          <a href="/privacy-policy" class="transition-colors hover:text-ink-900">מדיניות פרטיות</a>
          <a href="/accessibility-statement" class="transition-colors hover:text-ink-900">הצהרת נגישות</a>
        </div>
        <p class="text-sm text-ink-500">© <span class="num">{year}</span> {site.nameHe}. כל הזכויות שמורות.</p>
      </div>
    </footer>

    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-ink-100 bg-white/95 p-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] backdrop-blur-lg sm:hidden">
      <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-ghost py-3 text-[0.9375rem]">וואטסאפ</a>
      <a href="#contact" class="btn btn-primary py-3 text-[0.9375rem]">לשיחת ייעוץ</a>
    </div>
    <div class="h-16 sm:hidden" aria-hidden="true"></div>
  </>
)}
