---
/**
 * The four things the company sells, as the route into each.
 *
 * Two markets sit side by side here and the cards say which is which, because
 * the difference is the thing a visitor most needs to place: the websites and
 * organic work are sold to service businesses in the United States, the three
 * paid channels to businesses in Israel. A card that hid that would send half
 * the readers to the wrong page.
 */
import { asset } from "../lib/asset";
import SectionHead from "./SectionHead.astro";

const services = [
  {
    href: "/websites",
    market: "ארצות הברית",
    title: "בניית אתרים וקידום אורגני",
    body: "אתרים לעסקי שירות בארצות הברית, עם התוכן, ההתאמה לפרופיל העסקי בגוגל מפות וקידום אורגני שוטף כשלב נפרד.",
    items: ["בנייה ושיפוצים", "גגות", "ארובות", "מנעולנות", "דלתות גראז׳"],
    cta: "לקטלוג האתרים",
    mark: "sites",
  },
  {
    href: "/google-ads",
    market: "ישראל",
    title: "קמפיינים בגוגל",
    body: "ניהול קמפיינים בחיפוש לעסקים שחיים מפניות, עם מילות מפתח שליליות, מעקב המרות ואופטימיזציה שבועית.",
    items: ["חיפוש לפי כוונה", "שיחות מהמודעה", "מיקוד לפי אזור שירות"],
    cta: "לעמוד הגוגל",
    mark: "google",
  },
  {
    href: "/meta",
    market: "ישראל",
    title: "קמפיינים בפייסבוק ואינסטגרם",
    body: "ניהול ממומן במטא בלי מתווכים: אתם מדברים עם מי שיושב על החשבון, ורואים כל חודש כמה פניות נכנסו.",
    items: ["מבנה לפי אזור שירות", "טופס ליד בתוך פייסבוק", "החלפת קריאייטיב שנשחק"],
    cta: "לעמוד המטא",
    mark: "meta",
  },
  {
    href: "/chatgpt-ads",
    market: "ישראל · חדש",
    title: "קמפיינים ב-ChatGPT",
    body: "הפלטפורמה נפתחה למפרסמים בישראל. חשיפה נוספת בערוץ חדש, בתקציב שמתחיל קטן ועולה רק לפי מגמה.",
    items: ["מתחילים בקטן", "מעקב המרות מהיום הראשון", "מתעדכנים בכל שינוי"],
    cta: "לעמוד ה-ChatGPT",
    mark: "openai",
  },
];
---

<section id="services" class="scroll-mt-20 px-5 py-24 lg:px-8 lg:py-32">
  <SectionHead kicker="מה אנחנו עושים" title="ארבעה שירותים, שני שווקים" />

  <div class="mx-auto mt-14 grid max-w-6xl gap-5 lg:grid-cols-2">
    {services.map((s, i) => (
      <a
        href={s.href}
        class="card lift group flex flex-col p-8 transition-colors hover:border-brand-300"
        data-reveal
        style={`--reveal-delay:${(i % 2) * 90}ms`}
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-wide text-brand-600">{s.market}</p>
            <h3 class="mt-2 text-2xl">{s.title}</h3>
          </div>

          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-paper" aria-hidden="true">
            {s.mark === "google" && (
              <svg viewBox="0 0 24 24" class="h-6 w-6">
                <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82Z" />
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24Z" />
                <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09Z" />
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75Z" />
              </svg>
            )}
            {s.mark === "meta" && (
              <svg viewBox="0 0 24 24" class="h-6 w-6">
                <path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07Z" />
              </svg>
            )}
            {s.mark === "openai" && (
              <svg viewBox="0 0 24 24" class="h-6 w-6">
                <path fill="#0B1424" d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.998-2.9 6.056 6.056 0 0 0-.748-7.073Zm-9.022 12.608a4.476 4.476 0 0 1-2.876-1.04l.142-.08 4.778-2.758a.795.795 0 0 0 .393-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.495 4.493Zm-9.66-4.125a4.471 4.471 0 0 1-.535-3.014l.142.085 4.783 2.758a.771.771 0 0 0 .78 0l5.843-3.369v2.333a.08.08 0 0 1-.033.061L9.74 19.95a4.499 4.499 0 0 1-6.14-1.646ZM2.341 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.677l5.814 3.354-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786a4.504 4.504 0 0 1-1.647-6.117Zm16.597 3.856-5.833-3.388L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.104v-5.677a.79.79 0 0 0-.407-.667Zm2.01-3.023-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.499 4.499 0 0 1 6.681 4.66ZM8.306 12.863l-2.02-1.164a.08.08 0 0 1-.038-.057V6.074a4.499 4.499 0 0 1 7.376-3.454l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681Zm1.098-2.366 2.602-1.5 2.607 1.5v3l-2.597 1.5-2.607-1.5Z" />
              </svg>
            )}
            {s.mark === "sites" && (
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none">
                <rect x="2.5" y="4" width="19" height="15" rx="2.5" stroke="#1B4F8A" stroke-width="1.8" />
                <path d="M2.5 8.5h19" stroke="#1B4F8A" stroke-width="1.8" />
                <circle cx="5.8" cy="6.3" r=".9" fill="#4C8FE0" />
                <circle cx="8.4" cy="6.3" r=".9" fill="#4C8FE0" />
              </svg>
            )}
          </span>
        </div>

        <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-600">{s.body}</p>

        <ul class="mt-5 flex flex-wrap gap-2">
          {s.items.map((it) => (
            <li class="rounded-full bg-paper px-3 py-1.5 text-[0.8125rem] font-semibold text-ink-600">{it}</li>
          ))}
        </ul>

        <span class="mt-7 inline-flex items-center gap-2 text-[0.9375rem] font-bold text-brand-600">
          {s.cta}
          <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" aria-hidden="true">
            <path d="M14 6l-6 6 6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    ))}
  </div>
</section>
