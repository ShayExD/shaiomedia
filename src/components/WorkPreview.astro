---
/**
 * A taste of the build work on the company page.
 *
 * Three sites, not the full catalogue: the point here is to prove the work
 * exists and send anyone interested to /websites, where every project is laid
 * out with what was built. Each card links to the live client site, because a
 * screenshot of a site that opens is worth more than a description of one.
 */
import { asset } from "../lib/asset";
import SectionHead from "./SectionHead.astro";
import { projects, verticals } from "../data/site";

/* The three the owner picked: a design-led showroom, a trade with nine service
   pages, and a remodeller carrying ten. */
const featured = ["vita-design", "svchimneysweep", "wcoasthome"]
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<section id="work" class="scroll-mt-20 border-t border-ink-100 px-5 py-24 lg:px-8 lg:py-32">
  <SectionHead kicker="מהעבודות" title="אתרים שבנינו, באוויר" />

  <div class="mx-auto mt-14 grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((p, i) => (
      <article
        class="card lift flex flex-col overflow-hidden"
        data-reveal
        style={`--reveal-delay:${i * 90}ms; --v: var(--v-${p.vertical})`}
      >
        {/* Fixed aspect and a top-anchored crop: these are long scroll shots,
            so anchoring anywhere else would show a strip of mid-page. */}
        <div class="aspect-[4/3] overflow-hidden bg-paper">
          <img
            src={asset(`images/sites/${p.slug}-desktop.webp`)}
            alt={`האתר של ${p.name}`}
            width="1000"
            height="750"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-top"
          />
        </div>

        <div class="flex flex-1 flex-col p-6">
          <p class="inline-flex items-center gap-2 text-xs font-bold" style="color:var(--v)">
            <span class="h-2 w-2 rounded-full" style="background:var(--v)"></span>
            {verticals.find((v) => v.id === p.vertical)?.label}
          </p>

          <h3 class="mt-2 text-xl latin">{p.name}</h3>
          <p class="mt-1 text-sm text-ink-500">{p.city}</p>
          <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-600">{p.brief}</p>

          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-flex items-center gap-2 text-[0.9375rem] font-bold text-brand-600"
          >
            לאתר החי
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true">
              <path d="M14 6l-6 6 6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-10 text-center" data-reveal>
    <a href="/websites#work" class="btn btn-primary px-7 py-3.5">לקטלוג המלא</a>
  </div>
</section>
