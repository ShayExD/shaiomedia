---
import { edge } from "../data/site";
import SectionHead from "./SectionHead.astro";
---
<section class="bg-ink-50 px-5 py-24 lg:px-8 lg:py-32">
  <SectionHead kicker="למה אנחנו" title="למה דווקא אנחנו לעסק שירות בארצות הברית" />
  <div class="mx-auto mt-14 grid max-w-5xl gap-5 md:grid-cols-2">
    {edge.map((e, i) => (
      <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="card p-8">
        <h3 class="text-xl">{e.title}</h3>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-600">{e.body}</p>
      </div>
    ))}
  </div>
</section>
