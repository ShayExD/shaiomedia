---
import { includes } from "../data/site";
import SectionHead from "./SectionHead.astro";
---
<section id="includes" class="scroll-mt-20 px-5 py-24 lg:px-8 lg:py-32">
  <SectionHead
    kicker="מה כלול"
    title="מה בדיוק אתם מקבלים"
    sub="בלי חבילות מעורפלות ובלי כוכביות. זו הרשימה המלאה."
  />

  <div class="mx-auto mt-14 grid max-w-6xl gap-5 lg:grid-cols-3">
    {includes.map((g, i) => (
      <div data-reveal style={`--reveal-delay:${i * 90}ms`} class="card lift flex flex-col p-8">
        <span class="num text-sm font-extrabold text-brand-400">{g.n}</span>
        <h3 class="mt-2 text-2xl">{g.title}</h3>
        <ul class="mt-6 flex-1 space-y-3.5">
          {g.items.map((it) => (
            <li class="flex gap-3 text-[0.9375rem] leading-snug text-ink-600">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-100">
                <svg viewBox="0 0 20 20" class="h-3 w-3 text-brand-600" fill="none" aria-hidden="true">
                  <path d="m5 10.4 3 3 7-7.2" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div data-reveal class="mx-auto mt-8 max-w-6xl">
    <div class="flex flex-col items-center justify-between gap-5 rounded-[var(--radius-card)] bg-ink-900 p-8 text-center sm:flex-row sm:text-start lg:px-10">
      <div>
        <p class="text-xl font-bold text-white">רוצים לדעת מה נכון לעסק שלכם?</p>
        <p class="mt-1.5 text-[0.9375rem] text-ink-300">בשיחת ייעוץ קצרה נעבור על השירותים והאזורים שלכם ונגיד מה היינו בונים ראשון. בלי עלות.</p>
      </div>
      <a href="#contact" class="btn btn-primary shrink-0 px-7 py-3.5">לשיחת ייעוץ</a>
    </div>
  </div>
</section>
