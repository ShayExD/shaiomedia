---
import { nav, site } from "../data/site";
import Logo from "./Logo.astro";
---
<header
  id="nav" data-scrolled="false"
  class="nav fixed inset-x-0 top-0 z-50 border-b border-white/[0.07] bg-ink-950/72 backdrop-blur-xl transition-[background-color,border-color,box-shadow] duration-500 data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-ink-950/88 data-[scrolled=true]:shadow-[0_8px_34px_-14px_rgb(5_10_19/0.75)]"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-5 sm:h-[4.5rem] lg:px-8">
    <a href="#top" aria-label="שיו מדיה" class="shrink-0">
      <Logo white class="h-7 sm:h-8" />
    </a>

    <nav aria-label="ניווט ראשי" class="hidden items-center gap-1 md:flex">
      {nav.map((i) => (
        <a href={i.href} class="nav-link rounded-full px-4 py-2 text-[0.9375rem] font-medium transition-colors duration-200">{i.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.whatsapp} target="_blank" rel="noopener"
        class="nav-link hidden items-center gap-2 rounded-full px-3 py-2 text-[0.9375rem] font-bold lg:inline-flex">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.06c-.24.68-1.42 1.32-1.96 1.36-.5.05-.98.22-3.3-.7-2.77-1.1-4.53-3.94-4.67-4.13-.13-.19-1.11-1.48-1.11-2.83s.7-2 .95-2.28c.25-.27.55-.34.73-.34l.52.01c.17.01.4-.06.62.48.24.57.8 1.97.87 2.11.07.14.12.31.02.5-.09.19-.14.31-.28.47l-.42.49c-.14.14-.28.29-.12.57.16.27.72 1.19 1.55 1.93 1.07.95 1.97 1.25 2.25 1.39.27.14.43.12.59-.07.16-.19.68-.79.86-1.07.18-.27.36-.22.61-.13.25.09 1.6.75 1.87.89.27.14.46.2.53.32.07.11.07.65-.17 1.33Z"/></svg>
        וואטסאפ
      </a>
      <a href="#contact" class="btn btn-accent hidden px-5 py-2.5 text-[0.9375rem] sm:inline-flex">רוצה אתר כזה</a>

      <button id="menu-btn" type="button" aria-label="פתיחת תפריט" aria-expanded="false" aria-controls="mobile-menu"
        class="nav-link -me-1 inline-flex h-10 w-10 items-center justify-center rounded-full transition-transform duration-150 active:scale-95 md:hidden">
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
          <path id="mt" d="M4 8h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path id="mb" d="M4 16h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-white/10 bg-ink-950/95 backdrop-blur-xl md:hidden">
    <nav aria-label="ניווט נייד" class="flex flex-col gap-1 px-5 py-4">
      {nav.map((i, k) => (
        <a href={i.href} data-mi style={`--mi:${k * 34}ms`} class="rounded-xl px-3 py-3 text-lg font-semibold text-white/90 transition-colors hover:bg-white/10">{i.label}</a>
      ))}
      <div class="mt-3 grid grid-cols-2 gap-2.5">
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-glass px-4 py-3">וואטסאפ</a>
        <a href="#contact" class="btn btn-accent px-4 py-3">רוצה אתר כזה</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* The bar is transparent over the hero and a deep glass strip once content
     slides under it, so the wordmark stays light throughout. */
  .nav .nav-link { color: rgb(255 255 255 / 0.82); }
  .nav .nav-link:hover { color: #fff; background: rgb(255 255 255 / 0.1); }

  #mobile-menu { transition: opacity 240ms var(--ease-out-strong), transform 240ms var(--ease-out-strong); }
  #mobile-menu[data-state="closed"] { opacity: 0; transform: translateY(-8px); }
  #mobile-menu[data-state="open"] { opacity: 1; transform: none; }
  #mobile-menu [data-mi] {
    opacity: 0; transform: translateY(-6px);
    transition: opacity 220ms var(--ease-out-strong), transform 220ms var(--ease-out-strong);
    transition-delay: var(--mi);
  }
  #mobile-menu[data-state="open"] [data-mi] { opacity: 1; transform: none; }
  #mt, #mb { transition: transform 260ms var(--ease-out-strong); transform-origin: center; }
  #menu-btn[aria-expanded="true"] #mt { transform: translateY(4px) rotate(45deg); }
  #menu-btn[aria-expanded="true"] #mb { transform: translateY(-4px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu, #mobile-menu [data-mi], #mt, #mb { transition-duration: 1ms; }
    #mobile-menu[data-state="closed"] { transform: none; }
  }
</style>

<script>
  const header = document.getElementById("nav")!;
  const btn = document.getElementById("menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;

  const s = document.createElement("div");
  s.style.cssText = "position:absolute;top:0;height:1px;width:1px;";
  document.body.prepend(s);
  new IntersectionObserver(([e]) => header.setAttribute("data-scrolled", String(!e.isIntersecting)), { threshold: 0 }).observe(s);

  let open = false;
  function setOpen(next: boolean) {
    if (next === open) return;
    open = next;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "סגירת תפריט" : "פתיחת תפריט");
    if (open) {
      menu.hidden = false;
      menu.setAttribute("data-state", "closed");
      requestAnimationFrame(() => requestAnimationFrame(() => menu.setAttribute("data-state", "open")));
    } else {
      menu.setAttribute("data-state", "closed");
      menu.addEventListener("transitionend", function done(e) {
        if (e.propertyName !== "opacity" || open) return;
        menu.hidden = true;
        menu.removeEventListener("transitionend", done);
      });
    }
  }
  btn.addEventListener("click", () => setOpen(!open));
  menu.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) setOpen(false); });
  document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
  matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && setOpen(false));
</script>
