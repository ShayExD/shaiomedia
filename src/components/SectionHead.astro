---
interface Props { kicker?: string; title: string; sub?: string; center?: boolean; light?: boolean }
const { kicker, title, sub, center = true, light = false } = Astro.props;
---
<div class={`max-w-3xl ${center ? "mx-auto text-center" : ""}`}>
  {kicker && <p data-reveal class={`eyebrow ${light ? "!bg-white/10 !border-white/15 !text-brand-200" : ""}`}>{kicker}</p>}
  <h2
    data-reveal style="--reveal-delay:60ms"
    class={`mt-4 text-balance text-[clamp(2rem,4.8vw,3.5rem)] ${light ? "!text-white" : ""}`}
  >{title}</h2>
  {sub && (
    <p data-reveal style="--reveal-delay:120ms"
       class={`mx-auto mt-5 max-w-2xl text-[1.0625rem] leading-relaxed ${light ? "text-ink-200" : "text-ink-600"}`}
    >{sub}</p>
  )}
</div>
