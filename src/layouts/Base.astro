---
import { asset } from "../lib/asset";
import "../styles/global.css";
import { site } from "../data/site";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/seo". Root is "". */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD graph nodes for this page. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  path = "",
  ogImage = "/og/default.jpg",
  noindex = false,
  schema = [],
} = Astro.props;

const canonical = new URL(path || "/", site.url).href.replace(/\/$/, "") || site.url;
const ogUrl = new URL(ogImage, site.url).href;

/* Organization + WebSite are global; pages append their own nodes. */
const graph = [
  {
    "@type": "ProfessionalService",
    "@id": `${site.url}/#org`,
    name: site.nameHe,
    alternateName: site.name,
    url: site.url,
    description: site.description,
    email: site.email,
    telephone: site.phone,
    image: `${site.url}/og/default.jpg`,
    logo: { "@type": "ImageObject", url: `${site.url}/logo.png` },
    areaServed: { "@type": "Country", name: "ישראל" },
    knowsLanguage: ["he", "en"],
    priceRange: "$$",
    founder: [
      { "@type": "Person", name: "שי אייני" },
      { "@type": "Person", name: "שלו חג'ג'" },
    ],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "שירותי שיווק דיגיטלי",
      itemListElement: [
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "קידום אורגני" } },
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "קמפיינים במטא" } },
        { "@type": "Offer", itemOffered: { "@type": "Service", name: "מערכות אינטרנטיות" } },
      ],
    },
  },
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.nameHe,
    inLanguage: "he-IL",
    publisher: { "@id": `${site.url}/#org` },
  },
  ...schema,
];

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* A preview deploy must never be indexed alongside the real domain */}
    {noindex || import.meta.env.PUBLIC_PREVIEW === "1"
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    {/* Carried over from the WordPress site — removing it breaks Search Console */}
    <meta name="google-site-verification" content="RgUP188MUZfJkKe1_4Wn-LxqpQ69Zv47bq0gkCePn_I" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={site.nameHe} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#F8F7F4" />
    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    <link rel="sitemap" href="/sitemap.xml" />

    {/* Marks that JS is alive, before first paint — reveal styles key off this,
        so a failed/blocked script leaves the page fully visible instead of blank. */}
    <script is:inline>document.documentElement.classList.add("js");</script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:start-4 focus:z-[100] focus:rounded-xl focus:bg-ink-900 focus:px-5 focus:py-3 focus:text-paper"
      >דילוג לתוכן</a
    >

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Staggered reveal. Observer, not scroll listener — no main-thread cost per frame.
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        els.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-in");
              io.unobserve(e.target); // reveal once; re-animating on scroll-back is noise
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
